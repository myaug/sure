<%# locals: (mexc_item:, unlinked_count: mexc_item.unlinked_accounts_count, visible_accounts:) %>

<%= tag.div id: dom_id(mexc_item) do %>
  <%= render DS::Disclosure.new(variant: :card, open: true) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <%= icon "chevron-right", class: "group-open:rotate-90 motion-safe:transition-transform motion-safe:duration-150" %>

          <%= render ProviderLogo.new(provider_key: :mexc) %>

          <div class="pl-1 text-sm">
            <div class="flex items-center gap-2">
              <%= tag.p mexc_item.institution_display_name, class: "font-medium text-primary" %>
              <% if mexc_item.scheduled_for_deletion? %>
                <p class="text-destructive text-sm animate-pulse"><%= t(".deletion_in_progress") %></p>
              <% end %>
            </div>
            <p class="text-xs text-secondary"><%= t(".provider_name") %></p>
            <% if mexc_item.syncing? %>
              <div class="text-secondary flex items-center gap-1">
                <%= icon "loader", size: "sm", class: "animate-spin" %>
                <%= tag.span t(".syncing") %>
              </div>
            <% elsif mexc_item.requires_update? %>
              <div class="text-warning flex items-center gap-1">
                <%= icon "alert-triangle", size: "sm", color: "warning" %>
                <%= tag.span t(".reconnect") %>
              </div>
            <% else %>
              <p class="text-secondary">
                <% if mexc_item.last_synced_at %>
                  <% if mexc_item.sync_status_summary %>
                    <%= t(".status_with_summary", timestamp: time_ago_in_words(mexc_item.last_synced_at), summary: mexc_item.sync_status_summary) %>
                  <% else %>
                    <%= t(".status", timestamp: time_ago_in_words(mexc_item.last_synced_at)) %>
                  <% end %>
                <% else %>
                  <%= t(".status_never") %>
                <% end %>
              </p>
            <% end %>
          </div>
        </div>

        <% if Current.user&.admin? %>
          <div class="ml-auto flex items-center gap-2">
            <% if mexc_item.requires_update? %>
              <%= render DS::Link.new(
                text: t(".update_credentials"),
                icon: "refresh-cw",
                variant: "secondary",
                href: settings_providers_path,
                frame: "_top"
              ) %>
            <% else %>
              <%= icon(
                "refresh-cw",
                as_button: true,
                href: sync_mexc_item_path(mexc_item),
                disabled: mexc_item.syncing?
              ) %>
            <% end %>

            <%= render DS::Menu.new do |menu| %>
              <% sync_schedule_menu_item(menu, mexc_item) %>
              <% if mexc_item.unlinked_accounts_count > 0 %>
                <% menu.with_item(
                  variant: "link",
                  text: t(".import_accounts_menu"),
                  icon: "plus",
                  href: setup_accounts_mexc_item_path(mexc_item),
                  frame: :modal
                ) %>
              <% end %>
              <% menu.with_item(
                variant: "button",
                text: t(".delete"),
                icon: "trash-2",
                href: mexc_item_path(mexc_item),
                method: :delete,
                confirm: CustomConfirm.for_resource_deletion(mexc_item.institution_display_name, high_severity: true)
              ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% unless mexc_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if visible_accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: visible_accounts %>
          <% mexc_item.stale_rate_accounts.where(accounts: { id: visible_accounts.map(&:id) }).each do |ba| %>
            <div class="flex items-center gap-2 text-xs text-warning px-1">
              <span class="font-mono">~</span>
              <%= icon "triangle-alert", size: "sm" %>
              <span>
                <%= t("mexc_items.mexc_item.stale_rate_warning",
                      date: ba.extra.dig("mexc", "rate_target_date")) %>
              </span>
            </div>
          <% end %>
        <% end %>

        <% stats = mexc_item.syncs.ordered.first&.sync_stats || {} %>
        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: mexc_item, show_account_details: visible_accounts.size == mexc_item.accounts.size
        ) %>

        <% if mexc_item.unlinked_accounts_count > 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center bg-surface border border-primary rounded-xl">
            <p class="text-primary font-medium text-sm"><%= t(".setup_needed") %></p>
            <p class="text-secondary text-sm text-center"><%= t(".setup_description") %></p>
            <%= render DS::Link.new(
              text: t(".setup_action"),
              icon: "plus",
              variant: "primary",
              href: setup_accounts_mexc_item_path(mexc_item),
              frame: :modal
            ) %>
          </div>
        <% elsif mexc_item.accounts.empty? && mexc_item.mexc_accounts.none? %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t(".no_accounts_title") %></p>
            <p class="text-secondary text-sm"><%= t(".no_accounts_message") %></p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
